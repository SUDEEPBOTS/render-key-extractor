[Unit]
Description=Render Key Extractor Service
After=network.target tor.service
Wants=tor.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/render-key-service
Environment="PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/home/ubuntu/render-key-service"
ExecStart=/home/ubuntu/render-key-service/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
